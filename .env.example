# Variáveis de servidor. Usadas pelo Drizzle (db:push, db:studio) e pelas
# rotas /api/auth/* e /api/trpc/* do app web.
#
# O site público NÃO precisa destas variáveis: o conteúdo é publicado
# estaticamente e as páginas sobem sem banco. Só as rotas de API exigem.

DATABASE_URL=postgres://postgres:postgres@localhost:5432/temperos
BETTER_AUTH_SECRET=troque-por-uma-string-com-32-caracteres-ou-mais
BETTER_AUTH_URL=http://localhost:3001

# Object storage das fotos (Cloudflare R2). Opcionais: enquanto o site serve
# `public/images/`, nada aqui é obrigatório. Sem elas, os testes do adaptador
# em packages/media se pulam sozinhos.
#
# R2_ENDPOINT existe para apontar o adaptador a um MinIO local; em produção o
# endpoint é derivado de R2_ACCOUNT_ID.
# R2_ACCOUNT_ID=
# R2_BUCKET=sao-jorge
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_PUBLIC_URL=https://imagens.alimentossaojorge.com
# R2_ENDPOINT=http://localhost:9000
