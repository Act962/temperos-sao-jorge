# Variáveis de servidor. Usadas pelo Drizzle (db:push, db:studio) e pelas
# rotas /api/auth/* e /api/trpc/* do app web.
#
# O site público NÃO precisa destas variáveis: o conteúdo é publicado
# estaticamente e as páginas sobem sem banco. Só as rotas de API exigem.

DATABASE_URL=postgres://postgres:postgres@localhost:5432/temperos
BETTER_AUTH_SECRET=troque-por-uma-string-com-32-caracteres-ou-mais
BETTER_AUTH_URL=http://localhost:3001
