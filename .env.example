# Variáveis de servidor. Usadas pelo Drizzle (db:push, db:studio) e pelas
# rotas /api/auth/* e /api/trpc/* do app web.
#
# O site público sobe sem estas variáveis, servindo a reserva de
# apps/web/src/data/. Com elas, lê o catálogo do banco a cada visita e o
# painel funciona.

DATABASE_URL=postgres://postgres:postgres@localhost:5432/temperos
BETTER_AUTH_SECRET=troque-por-uma-string-com-32-caracteres-ou-mais
BETTER_AUTH_URL=http://localhost:3001

# Bucket das fotos enviadas pelo painel (Cloudflare R2). Opcionais: sem elas o
# site e o painel funcionam, o campo de foto aparece desligado e os testes de
# envio se pulam sozinhos. O app lê estas variáveis de apps/web/.env.
#
# R2_ENDPOINT existe para apontar o adaptador a um MinIO local; em produção o
# endpoint é derivado de R2_ACCOUNT_ID. R2_PUBLIC_URL é o endereço de onde o
# navegador baixa as fotos — o domínio ligado ao bucket, ou
# http://localhost:9000/<bucket> no MinIO.
# R2_ACCOUNT_ID=
# R2_BUCKET=sao-jorge
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_PUBLIC_URL=https://imagens.alimentossaojorge.com
# R2_ENDPOINT=http://localhost:9000
